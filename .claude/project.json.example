{
  "// INSTRUCTIONS": "Copy this file to your project's .claude/project.json and customize the values below.",

  "variables": {
    "PROJECT_ROOT": "<absolute path to YOUR_PROJECT>",
    "PROJECT_NAME": "YourProject",
    "GITHUB_REPO": "your-username/your-repo",
    "TOOLS_DIR": "<absolute path to YOUR_PROJECT>/tools",
    "WORKTREE_PATTERN": "YourProject-{ID}"
  },

  "inherit_from": "<absolute path to the Projects directory>",

  "// VARIABLE REFERENCE": {
    "PROJECT_ROOT": "Unix-style absolute path to the project (for Bash commands)",
    "PROJECT_NAME": "Human-readable project name (used in Gemini prompts, worktree patterns, and messages)",
    "GITHUB_REPO": "GitHub repository in owner/repo format (for gh CLI commands)",
    "TOOLS_DIR": "Unix-style path to the project's tools directory",
    "WORKTREE_PATTERN": "Pattern for naming worktrees (e.g., ProjectName-{ID})"
  },

  "// GENERATED FILES": {
    "commands/cleanup.md": "Session cleanup skill",
    "hooks/*.sh": "Pre/post edit hooks for safety checks",
    "settings.json": "Claude Code settings",
    "gemini-prompts/lld-review.txt": "Gemini LLD review prompt",
    "gemini-prompts/implementation-review.txt": "Gemini implementation review prompt",
    "gemini-prompts/issue-review.txt": "Gemini issue review prompt"
  },

  "// GEMINI INTEGRATION": {
    "description": "The generator creates Gemini review prompts for dual-AI review",
    "prerequisites": [
      "Antigravity CLI (agy) installed and signed in on the subscription (ADR 0220); there is no paid-API fallback",
      "The reviewer model is config.REVIEWER_MODEL in AssemblyZero; never one on config.FORBIDDEN_MODELS"
    ],
    "usage": [
      "Replace {{LLD_PATH}} and {{LLD_CONTENT}} placeholders before invoking"
    ]
  },

  "// USAGE": [
    "1. Copy this file to your project: cp .claude/project.json.example YourProject/.claude/project.json",
    "2. Edit the values in 'variables' section",
    "3. From YOUR_PROJECT, run the generator: poetry run --directory ../AssemblyZero python ../AssemblyZero/tools/assemblyzero-generate.py --project YourProject",
    "4. The generator will create concrete configs from templates"
  ]
}
